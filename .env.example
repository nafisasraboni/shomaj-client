# MongoDB shared by Better Auth and the event API.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/shomaj
MONGODB_DB_NAME=shomaj

# Better Auth. Generate a unique secret for every deployed environment.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Public Express API origin. Do not include a trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8787
